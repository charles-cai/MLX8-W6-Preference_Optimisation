# =============================================================================
# Agent1: Mini Edge Data Scientist - Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# MODEL CONFIGURATION
# -----------------------------------------------------------------------------
# IMPORTANT: Qwen3 models have TWO modes:
#   - Thinking mode (default): Outputs <think>...</think> tags for reasoning
#   - Non-thinking mode: Direct answers without internal reasoning
#
# For RL training, we typically want NON-THINKING mode for cleaner outputs.
#
# Options:
#   - Qwen/Qwen3-4B         (instruct with thinking) - use ENABLE_THINKING=false
#   - Qwen/Qwen3-4B-Base    (pure base model, no chat template)
#   - Qwen/Qwen2.5-3B-Instruct (alternative, no thinking mode)
#
MODEL_ID=Qwen/Qwen3-1.7B

# When false, the chat template adds empty <think></think> tags which
# instructs the model to skip thinking and respond directly
ENABLE_THINKING=false

# -----------------------------------------------------------------------------
# PROMPT CONFIGURATION
# -----------------------------------------------------------------------------
# Preset from prompts.toml: "math", "data_scientist", etc.
PROMPT_PRESET=data_scientist

# -----------------------------------------------------------------------------
# SHARED TRAINING SETTINGS (used by both curriculum and executor)
# -----------------------------------------------------------------------------
LEARNING_RATE=1e-6
NUM_GENERATIONS=2                    # GRPO rollouts per prompt (min: 2)
PER_DEVICE_BATCH_SIZE=2              # Base batch size (multiplied by NUM_GENERATIONS)
GRADIENT_ACCUMULATION_STEPS=2
MAX_COMPLETION_LENGTH=2048           # Max tokens for generation

# Generation parameters (paper uses high temp for diversity)
TEMPERATURE=1.0
TOP_P=0.99

# -----------------------------------------------------------------------------
# CURRICULUM AGENT SETTINGS (train_curriculum.py)
# Used in: Algorithm 1, Lines 3-10 (Curriculum Evolution)
# -----------------------------------------------------------------------------
CURRICULUM_MAX_STEPS=5               # Training steps for curriculum
CURRICULUM_NUM_PROMPTS=100           # Number of curriculum generation prompts
CURRICULUM_BATCH_SIZE=2              # Per-device batch size for curriculum
CURRICULUM_GRAD_ACCUM=4              # Gradient accumulation for curriculum
CURRICULUM_K_ROLLOUTS=2              # GRPO rollouts for curriculum (alias: NUM_GENERATIONS)

# -----------------------------------------------------------------------------
# EXECUTOR AGENT SETTINGS (train_executor.py)
# Used in: Algorithm 1, Lines 11-24 (Executor Evolution)
# -----------------------------------------------------------------------------
EXECUTOR_MAX_STEPS=40                # Training steps for executor
EXECUTOR_NUM_TASKS=200               # Number of tasks to generate from curriculum
EXECUTOR_BATCH_SIZE=2                # Per-device batch size for executor
EXECUTOR_GRAD_ACCUM=4                # Gradient accumulation for executor
EXECUTOR_K_ROLLOUTS=2                # GRPO rollouts for executor
EXECUTOR_K=2                         # Samples for self-consistency p̂ computation

# -----------------------------------------------------------------------------
# CO-EVOLUTION SETTINGS
# -----------------------------------------------------------------------------
NUM_ITERATIONS=1                   # Number of curriculum↔executor iterations

# -----------------------------------------------------------------------------
# REWARD PARAMETERS (from paper Table 8)
# Used by: CurriculumRewardComputer in train_curriculum.py
# -----------------------------------------------------------------------------
# Frontier filtering threshold (paper: 0.25)
# Keeps tasks with p̂ ∈ [0.5-DELTA, 0.5+DELTA] = [0.25, 0.75]
DELTA=0.25

# R_unc weight (Eq 5): λ_unc · R_unc
LAMBDA_UNC=1.0

# R_tool weight (Eq 5): λ_tool · R_tool
LAMBDA_TOOL=0.6

# Tool reward scale (Eq 3): γ · min(N_tool, C)
GAMMA_TOOL=0.6

# Tool reward cap (Eq 3): max rewarded tool calls
CAP_TOOL=4

# -----------------------------------------------------------------------------
# MEMORY OPTIMIZATION
# -----------------------------------------------------------------------------
GRADIENT_CHECKPOINTING=true
USE_LORA=false
LORA_R=32

# -----------------------------------------------------------------------------
# CHECKPOINTS & LOGGING
# -----------------------------------------------------------------------------
SAVE_STEPS=5
LOGGING_STEPS=1
SAVE_TOTAL_LIMIT=3

# -----------------------------------------------------------------------------
# WANDB LOGGING
# -----------------------------------------------------------------------------
WANDB_PROJECT=rl-hackathon-agent1
# WANDB_API_KEY=your_api_key_here
WANDB_ENTITY=your_entity
WANDB_DIR=./.wandb
WANDB_RUN_PREFIX=agent1
USE_WANDB=true

# -----------------------------------------------------------------------------
# OUTPUT
# -----------------------------------------------------------------------------
OUTPUT_DIR=./outputs

# -----------------------------------------------------------------------------
# ABLATION MODE (for experiments)
# -----------------------------------------------------------------------------
ABLATION_MODE=false
ABLATION_NAME=baseline