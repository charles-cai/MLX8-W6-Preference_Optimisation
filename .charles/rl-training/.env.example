# ============================================================================
# Agent1 Configuration - Example
# Mini Edge Data Scientist (evolved from Agent0 paper)
# Copy to .env and customize as needed
# ============================================================================

# Base Model
MODEL_ID=Qwen/Qwen3-0.6B

# Output Directories
OUTPUT_DIR=./outputs
CURRICULUM_OUTPUT_DIR=./outputs/curriculum
EXECUTOR_OUTPUT_DIR=./outputs/executor

# ============================================================================
# Prompt Configuration
# ============================================================================

# Available presets (defined in prompts.toml):
#   - math: Competition math problems (paper default)
#   - data_scientist: Mini edge data scientist (math + data analysis + coding)
#   - coding: Algorithmic challenges
#   - reasoning: General logic puzzles
PROMPT_PRESET=data_scientist

# ============================================================================
# Training Hyperparameters (from Paper Table 8)
# ============================================================================

# Co-evolution
NUM_ITERATIONS=1  # T=1 for MVP, paper uses T=3

# Curriculum Agent Training
CURRICULUM_MAX_STEPS=5
CURRICULUM_BATCH_SIZE=2
CURRICULUM_GRAD_ACCUM=4
CURRICULUM_K_ROLLOUTS=4

# Executor Agent Training
EXECUTOR_MAX_STEPS=40
EXECUTOR_BATCH_SIZE=2
EXECUTOR_GRAD_ACCUM=4
EXECUTOR_K_ROLLOUTS=4
EXECUTOR_K_SAMPLES=4  # for p̂ computation

# Shared Training Settings
LEARNING_RATE=1e-6
WEIGHT_DECAY=0.01
TEMPERATURE=1.0
TOP_P=0.99
MAX_NEW_TOKENS=2048

# ============================================================================
# Reward Function Parameters (from Paper)
# ============================================================================

LAMBDA_UNC=1.0
LAMBDA_TOOL=0.6
GAMMA_TOOL=0.6
CAP_TOOL=4
DELTA=0.25

# ============================================================================
# Task Generation
# ============================================================================

NUM_CURRICULUM_PROMPTS=100
NUM_TASKS_TO_GENERATE=200

# ============================================================================
# LoRA Configuration (optional)
# ============================================================================

USE_LORA=false
LORA_R=32
LORA_ALPHA=64
LORA_DROPOUT=0.05

# ============================================================================
# Weights & Biases
# ============================================================================

# Single unified project for all Agent1 runs
WANDB_PROJECT=rl-hackathon-agent1
WANDB_ENTITY=your_entity
# WANDB_API_KEY=your_key_here

# Store wandb logs in .wandb folder (gitignored)
WANDB_DIR=./.wandb

# Run name prefix
WANDB_RUN_PREFIX=agent1

# ============================================================================
# Checkpoint Configuration
# ============================================================================

# Save checkpoints every N steps (0 = only save final)
SAVE_STEPS=5

# Keep only last N checkpoints (0 = keep all)
SAVE_TOTAL_LIMIT=3

# Save optimizer state (larger files but allows resume)
SAVE_OPTIMIZER=false

# Enable gradient checkpointing (saves ~30-40% VRAM but slower training)
# Note: Causes harmless "Caching is incompatible" warnings with Qwen3
GRADIENT_CHECKPOINTING=false